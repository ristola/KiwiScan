def create_udev_rule():
    udev_rule_file = "/etc/udev/rules.d/99-usb-script.rules"
    if not os.path.exists(udev_rule_file):
        rule_content = (
            'SUBSYSTEMS=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", '
            'MODE="0666", RUN+="{}"'.format(SCRIPT_PATH)
        )
        with open(udev_rule_file, "w") as f:
            f.write(rule_content)
        subprocess.run(["sudo", "udevadm", "control", "--reload-rules"], check=True)
        subprocess.run(["sudo", "systemctl", "restart", "systemd-udevd"], check=True)


